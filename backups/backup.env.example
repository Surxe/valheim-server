# backup.env.example — copy to a NON-repo, root-only path and fill in.
# Real file location on the box:  /etc/home-server/backup.env   (chmod 600, root:root)
# NEVER commit the filled-in version. Secrets live here + in Ethan's password manager.
#
# --- restic encryption password (flash + B2 repos share it) ------------------
# Point restic at a password *file* so the secret isn't in argv/env dumps.
RESTIC_PASSWORD_FILE=/etc/home-server/restic-password        # file contains the passphrase, chmod 600
#
# --- Backblaze B2 (world-save offsite repo) ----------------------------------
# App key scoped to the `valheim-server` bucket (read+write+delete). NOTE: the B2
# WORLD backup runs INSIDE the Valheim VM (world lives there); stage this env in the VM
# at /etc/home-server/backup.env too. The host copy is for host-side restic/vzdump.
B2_ACCOUNT_ID=__FILL_ME__          # = the bucket-scoped keyID
B2_ACCOUNT_KEY=__FILL_ME__         # = the bucket-scoped applicationKey
B2_BUCKET=valheim-server        # actual bucket the key is scoped to
#
# --- Valheim guest (for vzdump) ----------------------------------------------
VALHEIM_VMID=__FILL_ME__           # set once the Valheim VM exists (see guests/)
