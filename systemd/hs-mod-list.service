[Unit]
Description=home-server: post the installed Valheim mod list (req/opt + versions) to Discord
Documentation=file:///srv/dev/repos/valheim-server/valheim/list-installed-mods.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Posts to the #valheim-server-status channel (same webhook as hs-valheim-status).
# Leading '-' makes it optional so the timer doesn't hard-fail before the webhook is
# staged; the script then logs "DISCORD_WEBHOOK_URL not set" and exits 0 instead of posting.
EnvironmentFile=-/etc/home-server/discord-server-status.env
ExecStart=/srv/dev/repos/valheim-server/valheim/list-installed-mods.sh --post
Nice=10
