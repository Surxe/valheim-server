# discord-server-status.env — Discord webhook for the #valheim-server-status channel.
# All FOUR Discord feeds post here (same channel):
#   hs-valheim-status    — up/down + players online, hourly
#   hs-mod-list          — installed mods (required/optional + versions), daily
#   hs-mod-check-discord — mod version-update alerts (change-only)
#   hs-mod-announce      — mod-set CHANGE announcement (diff, req/opt), agent-triggered
#
# The REAL file is NEVER committed. Install it to:
#     /etc/home-server/discord-server-status.env      (owner root:root, chmod 600)
# Both services load it via EnvironmentFile, so it becomes an env var for the scripts.
# (*.env is gitignored; only this .example is kept.)
#
# Webhook: Discord -> Server Settings -> Integrations -> Webhooks -> New Webhook ->
#   pick #valheim-server-status -> Copy Webhook URL
#   (https://discord.com/api/webhooks/<id>/<token>)

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_WITH_WEBHOOK_ID/REPLACE_WITH_TOKEN

# Optional: @-ping role(s) on hs-mod-announce (the mod-set CHANGE announcement) only.
# Comma-separated numeric Discord role IDs; only these roles are pinged (never @everyone).
# Get an ID: Discord -> User Settings -> Advanced -> Developer Mode ON, then right-click the
# role (e.g. "valheim server") -> Copy Role ID. Leave unset/commented for no ping.
#MOD_ANNOUNCE_ROLE_IDS=123456789012345678
# (multiple: MOD_ANNOUNCE_ROLE_IDS=1111111111,2222222222)

# Optional overrides for the status reporter (defaults shown) — usually leave commented:
#VALHEIM_VMID=100
#VALHEIM_CONTAINER=valheim
