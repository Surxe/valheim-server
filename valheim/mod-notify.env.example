# mod-notify.env — SMTP credentials for the hs-mod-check email alert.
#
# The REAL file is NEVER committed. Install it to:
#     /etc/home-server/mod-notify.env      (owner root:root, chmod 600)
# systemd/hs-mod-check.service loads it via EnvironmentFile, so these become env
# vars for notify-mod-updates.sh. (*.env is gitignored; only this .example is kept.)
#
# Gmail requires an APP PASSWORD, not the account password:
#     https://myaccount.google.com/apppasswords
# (2-Step Verification must be on for the sending account to mint one.)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=REPLACE_WITH_GMAIL_APP_PASSWORD
MAIL_FROM=you@example.com
MAIL_TO=you@example.com
