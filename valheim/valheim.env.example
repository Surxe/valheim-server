# valheim.env.example — copy to /etc/valheim/valheim.env on the VM (chmod 600) and fill in.
# These are Ethan's value-choices; NOT secrets-in-repo. The real file is not committed.
#
# NOTE: changing WORLD_NAME later starts a BRAND NEW world (the save is keyed by name).
# Pick the real name ONCE before anyone plays.
SERVER_NAME=home-server-PLACEHOLDER      # shown in the crossplay browser
WORLD_NAME=PLACEHOLDER                    # save file name under /config/worlds_local
SERVER_PASS=changeme                      # >=5 chars, must NOT be a substring of SERVER_NAME
ADMINLIST_IDS=                            # optional: space-separated PlayFab/Steam IDs for admins
